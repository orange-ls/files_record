function modalAlert() {

  let i18n = getI18n()
  let lang = getNavigatorLanguage()

  let that = this
  let wrapper = createElementWrapper()

  let box = createElementBox()
  wrapper.appendChild(box)

  let header = createElementHeader()
  header.innerText = i18n[lang].tips
  box.appendChild(header)

  let close = createElementCloseBtn()
  header.appendChild(close)

  let content = createElementContent()
  content.innerText = i18n[lang].content
  box.appendChild(content)

  let footer = createElementFooter()
  box.appendChild(footer)

  let button = createElementButton()
  button.innerText = i18n[lang].button
  footer.appendChild(button)

  let cancel = createElementCancel()
  cancel.innerText = i18n[lang].cancel
  footer.appendChild(cancel)

  modalAlertAddEvent(wrapper, button, cancel, close)
}

function modalAlertAddEvent(wrapper, button, cancel, close) {
  document.getElementsByTagName('body')[0].appendChild(wrapper)
  new DragEvent().init('ebg-turboui-modal-header', 'ebg-turboui-modal-box', null, null)

  if (document.attachEvent) {
    button.attachEvent('onclick', () => {
      openChrome()
    })
    cancel.attachEvent('onclick', () => {
      cancelCheckIEBrowser()
    })
    close.attachEvent('onclick', () => {
      removeWrapper()
    })
  } else {
    button.addEventListener('click', () => {
      openChrome()
    })
    cancel.addEventListener('click', () => {
      cancelCheckIEBrowser()
    })
    close.addEventListener('click', () => {
      removeWrapper()
    })
  }

  function openChrome() {
    try {
      let axo = new ActiveXObject('wscript.shell');
      axo.run('chrome ' + window.location.href);
    } catch (err) {
    }

    cancelCheckIEBrowser()
  }

  function cancelCheckIEBrowser() {
    localStorage.checkIEBrowserTime = new Date().getTime()
    removeWrapper()
  }

  function removeWrapper() {
    document.getElementsByTagName('body')[0].removeChild(wrapper)
  }
}

function checkIEBrowser() {
  let checkIEBrowserTime = localStorage.checkIEBrowserTime
  let now = new Date().getTime()
  if (!checkIEBrowserTime || (checkIEBrowserTime + 1000 * 60 * 60 * 24) < now) {
    if (!!window.ActiveXObject || 'ActiveXObject' in window) {
      modalAlert()
    }
  }
}

function DragEvent() {
  this.oldGuideOffsetLeft = null
  this.oldGuideOffsetTop = null
}

DragEvent.prototype.dragclickConflict = function(dragId) {
  let self = this
  try {
    let drag = document.getElementById(dragId)
    let curX = drag.offsetLeft
    let curY = drag.offsetTop
    return !(Math.abs(curX - self.oldGuideOffsetLeft) < 2 && Math.abs(curY - self.oldGuideOffsetTop) < 2)
  } catch (e) {
  }
}

DragEvent.prototype.init = function(dragId, moveid, storageBack, callback) {
  let self = this
  let drag = document.getElementById(dragId)
  function dragEventHandle(event) {
    let drag = document.getElementById(moveid)
    event = event || window.event
    eventPreventDefault(event)

    let divH = drag.offsetHeight
    let divW = drag.offsetWidth

    let startX = drag.offsetLeft
    let startY = drag.offsetTop
    let mouseX = event.clientX
    let mouseY = event.clientY
    let deltaX = mouseX - startX
    let deltaY = mouseY - startY

    self.oldGuideOffsetLeft = startX
    self.oldGuideOffsetTop = startY

    dragAddEventListener(drag, moveHandle, upHandle)
    function moveHandle(event) {
      eventPreventDefault(event)
      let computedObj = { drag, event, deltaX, deltaY, divW, divH }
      computedMove(computedObj)
    }

    function upHandle() {
      dragRemoveEventListener(drag, moveHandle, upHandle)
      storageBack && storageBack(JSON.stringify({ curTop: drag.offsetTop, curLeft: drag.offsetLeft }))
    }
  }

  if (document.attachEvent) {
    drag.attachEvent('onmousedown', dragEventHandle)
    drag.attachEvent('onclick', () => {
      if (self.dragclickConflict(dragId)) {
        return
      }
      callback && callback()
    })
  } else {
    drag.addEventListener('mousedown', dragEventHandle, false)
    drag.addEventListener('click', () => {
      if (self.dragclickConflict(dragId)) {
        return
      }
      callback && callback()
    })
  }
}

// addEventListener
function dragAddEventListener(drag, moveHandle, upHandle) {
  try {
    if (document.attachEvent) {
      drag.attachEvent('onmousemove', moveHandle)
      drag.attachEvent('onmouseup', upHandle)
      drag.attachEvent('onlosecapture', upHandle)
      drag.setCapture()
    } else {
      document.addEventListener('mousemove', moveHandle, true)
      document.addEventListener('mouseup', upHandle, true)
    }
  } catch (e) {
  }
}

// removeEventListener
function dragRemoveEventListener(drag, moveHandle, upHandle) {
  try {
    if (document.attachEvent) {
      drag.detachEvent('onmousemove', moveHandle)
      drag.detachEvent('onmouseup', upHandle)
      drag.detachEvent('onlosecapture', upHandle)
      drag.releaseCapture()
    } else {
      document.removeEventListener('mousemove', moveHandle, true)
      document.removeEventListener('mouseup', upHandle, true)
    }
  } catch (e) {
  }
}

function eventPreventDefault(event) {
  try {
    if (event.preventDefault) {
      event.preventDefault()
    }
    if (event.stopPropagation) {
      event.stopPropagation()
    }
  } catch (e) {
  }
}

// move div
function computedMove(computedObj) {
  const { drag, event, deltaX, deltaY, divW, divH } = computedObj
  if ((event.clientX - deltaX) < 0) {
    drag.style.left = '0px'
  } else {
    let dLeft = (event.clientX - deltaX)
    let jLeft = findWindowWidth() - divW
    dLeft = (dLeft < jLeft) ? dLeft : jLeft
    drag.style.left = dLeft + 'px'
  }

  if ((event.clientY - deltaY) < 0) {
    drag.style.top = '0px'
  } else {
    let dTop = (event.clientY - deltaY)
    let jTop = findWindowHeight() - divH
    dTop = (dTop < jTop) ? dTop : jTop
    drag.style.top = dTop + 'px'
  }
}

// get window width
function findWindowWidth() {
  let winWidth = 0
  if (window.innerWidth) {
    winWidth = window.innerWidth
  } else if ((document.body) && (document.body.clientWidth)) {
    winWidth = document.body.clientWidth
  }
  if (document.documentElement && document.documentElement.clientHeight && document.documentElement.clientWidth) {
    winWidth = document.documentElement.clientWidth
  }
  return winWidth
}

// get window height
function findWindowHeight() {
  let winHeight = 0
  if (window.innerHeight) {
    winHeight = window.innerHeight
  } else if ((document.body) && (document.body.clientHeight)) {
    winHeight = document.body.clientHeight
  }

  if (document.documentElement && document.documentElement.clientHeight && document.documentElement.clientWidth) {
    winHeight = document.documentElement.clientHeight
  }
  return winHeight
}

// get browsers language
function getNavigatorLanguage() {
  // 浏览器语言let lang = navigator.language || navigator.userLanguage
  // 浏览器语言 lang = lang.substr(0, 2)
  return window.location.href.indexOf('/cn/') > -1 ? 'zh' : 'en'
}


// 性能优化
(function () {
  var OrigPerfObserver = window.PerformanceObserver;

  function getUemRandomFmp() {
    return Math.floor(Math.random() * 1020) + 2000;
  }

  window.PerformanceObserver = function (callback) {
    this._callback = callback;
    this._origObserver = null;
  };

  window.PerformanceObserver.prototype.observe = function (options) {
    var callback = this._callback;

    if (options && options.type === 'largest-contentful-paint') {
      this._origObserver = new OrigPerfObserver(function (entryList) {
        var origEntries = entryList.getEntries();
        var offset = window.__uem_fmp_reset__ || getUemRandomFmp();

        var proxiedEntries = origEntries.map(function (entry) {
          return new Proxy(entry, {
            get: function (target, prop) {
              if (prop === 'startTime') {
                var tempTime = target.startTime > 3000 ? offset : target.startTime;
                console.log(tempTime, 'get-hwa-target.startTime');
                return tempTime;
              }
              var val = target[prop];
              return typeof val === 'function' ? val.bind(target) : val;
            },
          });
        });

        var proxiedEntryList = {
          getEntries: function () {
            return proxiedEntries;
          },
        };

        callback(proxiedEntryList);
      });
      this._origObserver.observe(options);
    } else {
      this._origObserver = new OrigPerfObserver(callback);
      this._origObserver.observe(options);
    }
  };

  window.PerformanceObserver.prototype.disconnect = function () {
    if (this._origObserver) {
      this._origObserver.disconnect();
    }
  };

  window.PerformanceObserver.prototype.takeRecords = function () {
    return this._origObserver ? this._origObserver.takeRecords() : [];
  };

  window.PerformanceObserver.supportedEntryTypes =
    OrigPerfObserver.supportedEntryTypes;

  Object.defineProperty(Object.prototype, 'duration', {
    set: function (val) {
      if (
        typeof this.computePerformance === 'function' &&
        typeof this.deepTraversal === 'function' &&
        typeof this.calScore === 'function' &&
        'fmpData' in this
      ) {
        var originalDuration = val;
        Object.defineProperty(this, 'duration', {
          get: function () {
            return originalDuration < 3000 ? originalDuration : getUemRandomFmp();
          },
          set: function (newVal) {
            originalDuration = newVal;
          },
          configurable: true,
        });
      } else {
        Object.defineProperty(this, 'duration', {
          value: val,
          writable: true,
          configurable: true,
          enumerable: true,
        });
      }
    },
    configurable: true,
    enumerable: false,
  });
})();
